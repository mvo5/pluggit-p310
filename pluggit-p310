    #TempReg("prmBypassTmax", 446, "Maximum temperature of Bypass openning (C)"),
]

def set_mode(mode):
    mode_dict = {
        "demand": 0x2,
        "manual": 0x4,
        "week": 0x8,
    }
    prmRamIdxUnitMode = 168
    write_u32(mc, prmRamIdxUnitMode, mode_dict[mode])


def set_fan_level(level):
    prmRomIdxSpeedLevel = 324
    write_u32(mc, prmRomIdxSpeedLevel, level)


if __name__ == "__main__":
    mc = ModbusTcpClient(host=P310_IP)
    res=mc.connect()
    if res != True:
        print("cannot connect")
        sys.exit(1)

    if len(sys.argv) > 1 and sys.argv[1] == "--set-time":
         print("Setting time")
         prmDateTimeSet = 110
         tz = time.time()
         # add UTC+1 offset
         # FIXME: find via tz
         tz = tz + 60*60
         write_u32(mc, prmDateTimeSet, int(tz))

    if len(sys.argv) > 1 and sys.argv[1] == "--set-manual-mode":
        print("Set to manual mode")
        set_mode("manual")
        if len(sys.argv) > 2:
            set_fan_level(int(sys.argv[2]))
        time.sleep(0.2)
    if len(sys.argv) > 1 and sys.argv[1] == "--set-demand-mode":
        print("Set to demand mode")
        set_mode("demand")
        time.sleep(0.2)
    if len(sys.argv) > 1 and sys.argv[1] == "--set-week-program-mode":
        print("Set to week mode")
        set_mode("week")
        time.sleep(0.2)

    print("# Pluggit info")
    for reg in all_regs:
        reg.output(mc)

    mc.close()
